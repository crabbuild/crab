{
  "realm": "crab-dev",
  "displayName": "Crab",
  "displayNameHtml": "Crab",
  "loginTheme": "crab",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "accessTokenLifespan": 900,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"email\",\"displayName\":\"${email}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"annotations\":{\"inputType\":\"html5-email\"}},{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}}}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "groups": [{ "name": "crab-writers" }, { "name": "crab-readers" }],
  "clients": [
    {
      "clientId": "crab-browser",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:5175/auth/callback",
        "http://127.0.0.1:8788/auth/callback"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["profile", "email"],
      "protocolMappers": [
        {
          "name": "Crab groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "a11ce000-0000-4000-8000-000000000001",
      "username": "alice",
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Developer",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "crab-local", "temporary": false }
      ]
    },
    {
      "id": "b0b00000-0000-4000-8000-000000000002",
      "username": "bob",
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Developer",
      "enabled": true,
      "groups": ["/crab-writers"],
      "credentials": [
        { "type": "password", "value": "crab-local", "temporary": false }
      ]
    },
    {
      "id": "c0000000-0000-4000-8000-000000000003",
      "username": "reader",
      "email": "reader@example.test",
      "firstName": "Read",
      "lastName": "Only",
      "enabled": true,
      "groups": ["/crab-readers"],
      "credentials": [
        { "type": "password", "value": "crab-local", "temporary": false }
      ]
    },
    {
      "id": "d0000000-0000-4000-8000-000000000004",
