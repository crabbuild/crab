# Keep release-builder Docker contexts small. The crab CLI build needs the
# root Cargo workspace, workspace member manifests, and gitoxide path
# dependencies; it does not need docs caches, local build
# output, or repo metadata.
*

!Cargo.toml
!Cargo.lock
!Cross.toml
!.cargo/
!.cargo/**

!crab/
!crab/**
!crates/
!crates/**
!packages/
packages/*
!packages/ui/
!packages/ui/package.json
!packages/ui/package-lock.json
!packages/ui/index.html
!packages/ui/tsconfig.json
!packages/ui/vite.config.ts
!packages/ui/src/
!packages/ui/src/**
!packages/web/
packages/web/*
!packages/web/crab.optimized.svg
!deploy/
!deploy/crab-service/
!deploy/crab-service/compose/
!deploy/crab-service/compose/managed-read-e2e.sh
!beyond-desktop/
!beyond-desktop/agent/
!beyond-desktop/agent/**
!gitoxide/
!gitoxide/**

.git/
.crab/
.tmp-cache-e2e/
target/
**/target/
crab/dist/
node_modules/
**/node_modules/
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/id_dsa
**/id_ed25519
**/id_ecdsa
**/id_rsa
*.DS_Store
