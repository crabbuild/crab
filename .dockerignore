# Keep release-builder Docker contexts small. The crab CLI build needs the
# root Cargo workspace, workspace member manifests, and gitoxide path
# dependencies; it does not need docs caches, local build
# output, or repo metadata.
*

!Cargo.toml
!Cargo.lock
!Cross.toml
!.cargo/
!.cargo/**

!crab/
!crab/**
!crates/
!crates/**
!packages/
packages/*
!packages/repository/
!packages/repository/package.json
!packages/repository/package-lock.json
!packages/repository/index.html
!packages/repository/tsconfig.json
!packages/repository/vite.config.ts
!packages/repository/src/
!packages/repository/src/**
!deploy/
!deploy/crab-service/
!deploy/crab-service/compose/
!deploy/crab-service/compose/managed-read-e2e.sh
!beyond-desktop/
!beyond-desktop/agent/
!beyond-desktop/agent/**
!gitoxide/
!gitoxide/**

.git/
.crab/
.tmp-cache-e2e/
target/
**/target/
crab/dist/
node_modules/
**/node_modules/
*.DS_Store
