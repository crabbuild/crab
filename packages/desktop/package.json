{
  "name": "crab-desktop",
  "private": true,
  "version": "2.0.0-alpha.1",
  "description": "Crab — serverless git for large files. Desktop client built on Electron + React + TailwindCSS.",
  "author": "Crab",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/crabbuild/crab.git"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "dev:electron": "npm run build:electron && electron dist-electron/main.cjs",
    "build:icons": "bash scripts/generate-icons.sh",
    "build:agent": "node scripts/build-native.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/rename-to-cjs.mjs",
    "build": "npm run build:agent && npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'electron/**/*.ts'",
    "test": "node scripts/test.mjs",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:e2e-smoke": "node scripts/smoke.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:mac": "npm run build && node scripts/package.mjs --mac",
    "package:linux": "npm run build && node scripts/package.mjs --linux",
    "package:win": "npm run build && node scripts/package.mjs --win",
    "dist": "npm run build:icons && npm run package",
    "start": "electron .",
    "postinstall": "node scripts/install-native.mjs",
    "package:dir": "npm run build && node scripts/package.mjs --dir",
    "test:build": "node --test scripts/native-build.test.mjs scripts/assemble-release.test.mjs scripts/version-bump.test.mjs scripts/remote-runtime.test.mjs"
  },
  "dependencies": {
    "@bufbuild/cel": "^0.5.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.6.0",
    "@pierre/diffs": "^1.1.20",
    "@pierre/trees": "^1.0.0-beta.3",
    "@tanstack/react-virtual": "3.13.24",
    "@types/three": "^0.184.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "anser": "^2.3.5",
    "better-sqlite3": "^13.0.3",
    "blake3": "^2.1.7",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.14.0",
    "marked": "^15.0.0",
    "minimatch": "^10.2.5",
    "monaco-editor": "^0.52.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "react-window": "^1.8.11",
    "shell-env": "^4.0.3",
    "ssh2": "^1.17.0",
    "streamdown": "^2.5.0",
    "three": "^0.184.0",
    "typescript-language-server": "^5.1.3",
    "web-tree-sitter": "^0.22.0",
    "yaml": "^2.9.0",
    "zeromq": "^6.5.0",
    "zstd-napi": "^0.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.65.0",
    "@shikijs/monaco": "^4.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-check": "^4.7.0",
    "postcss": "^8.4.49",
    "shiki": "^4.0.2",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
