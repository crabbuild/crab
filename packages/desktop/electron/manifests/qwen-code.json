{
  "type": "qwen-code",
  "name": "Qwen Code",
  "binary": "qwen-code",
  "args": ["--print", "--output-format", "stream-json", "--permission-mode", "bypassPermissions", "{prompt}"],
  "env": {},
  "interactionModel": "stdio",
  "versionFlag": "--version",
  "eventMapping": {
    "typeField": "type",
    "typeMap": {
      "assistant": "text",
      "tool_use": "tool_use",
      "tool_result": "tool_result",
      "user": "generic",
      "result": "done",
      "thinking": "thinking",
      "error": "error"
    },
    "fieldMap": {
      "file": "path",
      "diff": "diff",
      "cmd": "command"
    },
    "contentField": "content",
    "errorField": "error",
    "toolField": "tool",
    "usageField": "usage",
    "usageMapping": {
      "inputTokens": "input_tokens",
      "outputTokens": "output_tokens",
      "cacheCreationInputTokens": "cache_creation_input_tokens",
      "cacheReadInputTokens": "cache_read_input_tokens"
    }
  },
  "capabilities": {
    "supportsPlanMode": true,
    "supportsStreaming": true,
    "supportsToolUse": true,
    "supportsIteration": true,
    "supportsApprovalModes": true
  },
  "requiredEnv": [
    { "name": "DASHSCOPE_API_KEY", "label": "DashScope API Key", "secret": true }
  ],
  "inputFormat": {
    "template": "{\"type\":\"user\",\"content\":\"{message}\"}"
  }
}
