{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "values": "<DVC_METRIC_DATA>"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#3b82f6",
        "#d97706",
        "#0d9488",
        "#a855f7"
      ]
    },
    "font": "system-ui"
  },
  "hconcat": [
    {
      "title": "Precision / recall",
      "width": 225,
      "height": 215,
      "transform": [
        {
          "filter": {
            "field": "panel",
            "equal": "Precision / recall"
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "title": "Recall"
        },
        "color": {
          "field": "<DVC_METRIC_COLOR>",
          "type": "nominal",
          "title": null,
          "legend": {
            "orient": "top",
            "labelLimit": 180,
            "columns": 2
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "point": false,
            "strokeWidth": 2
          },
          "encoding": {
            "y": {
              "field": "y",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1
                ]
              },
              "title": "Precision"
            },
            "tooltip": [
              {
                "field": "<DVC_METRIC_COLOR>",
                "title": "Run"
              },
              {
                "field": "threshold",
                "format": ".3f"
              },
              {
                "field": "x",
                "format": ".3f"
              },
              {
                "field": "y",
                "format": ".3f"
              }
            ]
          }
        }
      ]
    },
    {
      "title": "ROC",
      "width": 225,
      "height": 215,
      "transform": [
        {
          "filter": {
            "field": "panel",
            "equal": "ROC"
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "title": "False-positive rate"
        },
        "color": {
          "field": "<DVC_METRIC_COLOR>",
          "type": "nominal",
          "title": null,
          "legend": {
            "orient": "top",
            "labelLimit": 180,
            "columns": 2
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "point": false,
            "strokeWidth": 2
          },
          "encoding": {
            "y": {
              "field": "y",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1
                ]
              },
              "title": "True-positive rate"
            },
            "tooltip": [
              {
                "field": "<DVC_METRIC_COLOR>",
                "title": "Run"
              },
              {
                "field": "threshold",
                "format": ".3f"
              },
              {
                "field": "x",
                "format": ".3f"
              },
              {
                "field": "y",
                "format": ".3f"
              }
            ]
          }
        }
      ]
    },
    {
      "title": "Calibration",
      "width": 225,
      "height": 215,
      "transform": [
        {
          "filter": {
            "field": "panel",
            "equal": "Calibration"
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "title": "Mean predicted risk"
        },
        "color": {
          "field": "<DVC_METRIC_COLOR>",
          "type": "nominal",
          "title": null,
          "legend": {
            "orient": "top",
            "labelLimit": 180,
            "columns": 2
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "opacity": 0.35
          },
          "encoding": {
            "y": {
              "field": "lower",
              "type": "quantitative"
            },
            "y2": {
              "field": "upper"
            }
          }
        },
        {
          "mark": {
            "type": "line",
            "point": {
              "filled": true,
              "size": 18
            },
            "strokeWidth": 2
          },
          "encoding": {
            "y": {
              "field": "y",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1
                ]
              },
              "title": "Observed positive rate"
            },
            "tooltip": [
              {
                "field": "<DVC_METRIC_COLOR>",
                "title": "Run"
              },
              {
                "field": "x",
                "format": ".3f"
              },
              {
                "field": "y",
                "format": ".3f"
              },
              {
                "field": "lower",
                "format": ".3f"
              },
              {
                "field": "upper",
                "format": ".3f"
              },
              {
                "field": "count"
              }
            ]
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    }
  }
}
