{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditEvent",
  "type": "object",
  "required": [
    "digest",
    "event_id",
    "operation",
    "outcome",
    "schema_version",
    "timestamp_unix"
  ],
  "properties": {
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "default": null
    },
    "digest": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "outcome": {
      "$ref": "#/definitions/AuditOutcome"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "timestamp_unix": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "AuditOutcome": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    }
  }
}
