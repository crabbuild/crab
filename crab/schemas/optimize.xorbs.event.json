{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "$ref": "#/definitions/OptimizeXorbsEstimate"
    },
    {
      "$ref": "#/definitions/OptimizeXorbsSummary"
    },
    {
      "$ref": "#/definitions/OptimizeXorbsControlEvent"
    }
  ],
  "definitions": {
    "OptimizeXorbsControlEvent": {
      "description": "Control event emitted by xorb optimization management operations.",
      "properties": {
        "event": {
          "$ref": "#/definitions/OptimizeXorbsControlEventKind"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "event"
      ],
      "type": "object"
    },
    "OptimizeXorbsControlEventKind": {
      "description": "Control event kind for xorb optimization management operations.",
      "enum": [
        "journal_dropped",
        "aborted"
      ],
      "type": "string"
    },
    "OptimizeXorbsCounts": {
      "description": "Per-status counts in the summary.",
      "properties": {
        "corrupt": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "done": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "pending": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "skipped": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "corrupt",
        "done",
        "pending",
        "skipped"
      ],
      "type": "object"
    },
    "OptimizeXorbsEstimate": {
      "description": "Result of a dry-run estimation.",
      "properties": {
        "archive_source_bytes": {
          "description": "Bytes in archive-class source xorbs.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "archive_source_count": {
          "description": "Number of source xorbs in archive classes (skipped if `--include-cold=false`).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "estimated_cost_usd": {
          "description": "Estimated provider API cost in USD (6 decimal places).",
          "type": "string"
        },
        "estimated_dest_bytes": {
          "description": "Estimated bytes after recompression.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "estimated_dest_count": {
          "description": "Estimated number of destination xorbs.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "estimated_wall_secs": {
          "description": "Estimated wall-clock duration in seconds.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "profile": {
          "description": "Profile name used for the estimate.",
          "type": "string"
        },
        "source_bytes": {
          "description": "Total bytes across all source xorbs.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "source_count": {
          "description": "Number of source xorbs that would be processed.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "archive_source_bytes",
        "archive_source_count",
        "estimated_cost_usd",
        "estimated_dest_bytes",
        "estimated_dest_count",
        "estimated_wall_secs",
        "profile",
        "source_bytes",
        "source_count"
      ],
      "type": "object"
    },
    "OptimizeXorbsSummary": {
      "description": "Final summary payload for `--json` / `--jsonl` output.",
      "properties": {
        "bytes_read": {
          "description": "Total bytes read.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "bytes_written": {
          "description": "Total bytes written.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "corrupt_list": {
          "description": "List of corrupt source xorb hashes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "corrupt_list_omitted": {
          "description": "Number of corrupt source hashes omitted from the bounded report.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "counts": {
          "allOf": [
            {
              "$ref": "#/definitions/OptimizeXorbsCounts"
            }
          ],
          "description": "Counts by status."
        },
        "elapsed_ms": {
          "description": "Wall-clock duration in milliseconds.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "profile": {
          "description": "Profile used.",
          "type": "string"
        },
        "run_id": {
          "description": "Run identifier.",
          "type": "string"
        }
      },
      "required": [
        "bytes_read",
        "bytes_written",
        "corrupt_list",
        "corrupt_list_omitted",
        "counts",
        "elapsed_ms",
        "profile",
        "run_id"
      ],
      "type": "object"
    }
  },
  "description": "Payload variants emitted under the `optimize.xorbs.event` schema.",
  "title": "OptimizeXorbsEventPayload"
}
