{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StagingStatsPayload",
  "description": "Payload emitted by `crab staging stats --json`.",
  "type": "object",
  "required": [
    "chunk_count",
    "current_segment_bytes",
    "dead_bytes",
    "dead_ratio",
    "file_count",
    "files",
    "live_bytes",
    "segments_sealed",
    "total_staged_bytes"
  ],
  "properties": {
    "chunk_count": {
      "description": "Total number of staged chunks.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "current_segment_bytes": {
      "description": "Bytes written to the current (unsealed) segment.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "dead_bytes": {
      "description": "Bytes occupied by dead (unreferenced) chunks.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "dead_ratio": {
      "description": "Ratio of dead bytes to total staged bytes.",
      "type": "number",
      "format": "double"
    },
    "file_count": {
      "description": "Total number of registered files.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "files": {
      "description": "Per-file breakdown of staged chunks.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/StagedFileEntry"
      }
    },
    "live_bytes": {
      "description": "Bytes occupied by live (referenced) chunks.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "segments_sealed": {
      "description": "Number of sealed segments.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "total_staged_bytes": {
      "description": "Total bytes across all segments (sealed + current).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "StagedFileEntry": {
      "description": "Per-file entry in the staging stats JSON output.",
      "type": "object",
      "required": [
        "committed_chunks",
        "file_hash",
        "pending_chunks",
        "segments",
        "total_bytes",
        "total_chunks"
      ],
      "properties": {
        "committed_chunks": {
          "description": "Number of committed chunks (flushed to segment).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "file_hash": {
          "description": "Hex-encoded Blake3 file hash.",
          "type": "string"
        },
        "file_path": {
          "description": "Original file path relative to repo root, if recorded.",
          "type": [
            "string",
            "null"
          ]
        },
        "pending_chunks": {
          "description": "Number of pending chunks (not yet flushed).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "segments": {
          "description": "Number of distinct segments holding this file's data.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "total_bytes": {
          "description": "Original file size in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "total_chunks": {
          "description": "Total chunk count (committed + pending).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    }
  }
}
