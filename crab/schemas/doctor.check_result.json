{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CheckResult",
  "description": "A single diagnostic result.",
  "type": "object",
  "required": [
    "detail",
    "name",
    "status"
  ],
  "properties": {
    "detail": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/CheckStatus"
    }
  },
  "definitions": {
    "CheckStatus": {
      "description": "Outcome of a single diagnostic check.",
      "type": "string",
      "enum": [
        "ok",
        "warn",
        "fail"
      ]
    }
  }
}
