{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FileDonePayload",
  "description": "Completion event for a single file.",
  "type": "object",
  "required": [
    "bytes",
    "duration_ms",
    "path",
    "status"
  ],
  "properties": {
    "bytes": {
      "description": "Size of the file in bytes.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "duration_ms": {
      "description": "Wall-clock duration of the operation in milliseconds.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "path": {
      "description": "Relative path of the file.",
      "type": "string"
    },
    "status": {
      "description": "Outcome: `\"ok\"`, `\"failed\"`, or `\"skipped\"`.",
      "type": "string"
    }
  }
}
