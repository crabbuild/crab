  "title": "ErrorDocEntry",
  "description": "One row in the error catalog listing.",
  "type": "object",
  "required": [
    "category",
    "code",
    "message_template",
    "name",
    "remediation",
    "retryable"
  ],
  "properties": {
    "category": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "message_template": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "remediation": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    }
  }
}
