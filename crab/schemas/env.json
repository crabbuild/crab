{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnvPayload",
  "description": "Payload emitted by `crab env --json`.",
  "type": "object",
  "required": [
    "build_timestamp",
    "crab_version",
    "git_sha",
    "platform"
  ],
  "properties": {
    "build_timestamp": {
      "type": "string"
    },
    "crab_version": {
      "type": "string"
    },
    "git_sha": {
      "type": "string"
    },
    "git_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "type": "string"
    },
    "remote_url": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
