{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LsFileEntry",
  "description": "A single file entry in the JSON payload.",
  "type": "object",
  "required": [
    "hydrated",
    "name",
    "size"
  ],
  "properties": {
    "hydrated": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "oid": {
      "type": [
        "string",
        "null"
      ]
    },
    "size": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  }
}
