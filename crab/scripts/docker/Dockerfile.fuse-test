# Dockerfile for testing crab FUSE mount inside a container.
#
# Build:
#   docker build -f crab/scripts/docker/Dockerfile.fuse-test -t crab-fuse-test .
#
# Run (requires FUSE device + SYS_ADMIN):
#   docker run --rm --cap-add SYS_ADMIN --device /dev/fuse crab-fuse-test

FROM rust:1.87-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libfuse3-dev \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace root files first for layer caching.
COPY Cargo.toml Cargo.lock ./

# Copy the crates the workspace needs.
COPY crates/ crates/
COPY crab/ crab/
COPY beyond-desktop/agent/ beyond-desktop/agent/

RUN cargo build --release --manifest-path crab/Cargo.toml

# ---------------------------------------------------------------------------
# Runtime image — slim, with only the FUSE userspace tools.
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        fuse3 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/crab /usr/local/bin/crab

# Symlink so git can find the remote helper.
RUN ln -s /usr/local/bin/crab /usr/local/bin/git-remote-crab

COPY crab/scripts/docker/test-fuse.sh /usr/local/bin/test-fuse.sh
RUN chmod +x /usr/local/bin/test-fuse.sh

ENTRYPOINT ["/usr/local/bin/test-fuse.sh"]
