{
  "schema": "crab.sdk-capabilities",
  "version": 1,
  "activated_phase": 8,
  "operations": {
    "remote_read": "Remote snapshot / raw Git / hydrated file reads",
    "remote_write": "Remote commit/file edits / atomic refs",
    "local_edit": "Open local, stage, commit, status, checkout",
    "clone": "Clone full / branch / lazy or hydrated",
    "fetch": "Fetch refs / tags / prune",
    "shallow": "Shallow clone, deepen, unshallow",
    "pull": "Pull FF / merge / rebase, continue / abort",
    "push": "Push branch/tag create/update/delete",
    "atomic_push": "Atomic multi-ref push",
    "force_with_lease": "Force-with-lease",
    "dry_run": "Push dry-run",
    "partial_clone": "Partial clone filters / lazy Git object fetching",
    "advanced_worktrees": "Recursive submodules, sparse checkout, linked-worktree creation",
    "linked_worktree": "Open existing linked worktree",
    "sha256": "SHA-256 repository format",
    "management": "Direct initialization / managed lifecycle"
  },
  "backends": [
    "direct",
    "managed",
    "http"
  ],
