---
source: crab/src/tier/provider/gcs.rs
expression: json
---
{
  "lifecycle": {
    "rule": [
      {
        "action": {
          "type": "SetStorageClass",
          "storageClass": "NEARLINE"
        },
        "condition": {
          "age": 30,
          "matchesPrefix": [
            ".crab/xorbs/"
          ]
        }
      },
      {
        "action": {
          "type": "SetStorageClass",
          "storageClass": "ARCHIVE"
        },
        "condition": {
          "age": 365,
          "matchesPrefix": [
            ".crab/xorbs/"
          ]
        }
      }
    ]
  }
}
